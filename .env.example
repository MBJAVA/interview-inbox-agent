# Model (init_chat_model). Any LangChain-supported provider works; install its package.
MODEL_PROVIDER=openai
MODEL_NAME=gpt-6.1-terra
OPENAI_API_KEY=

# Web search
TAVILY_API_KEY=

# LangSmith tracing
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=interview-prep-agent

# Mocks: true = no Google account / no web needed
MOCK_GOOGLE=true
MOCK_WEB=true
# Offline scripted policy model (CI / no API key). Leave false to use the real model.
MOCK_LLM=false
